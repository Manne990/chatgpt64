OPENAI_API_KEY=sk-your-key-here

# Optional
CHATGPT64_HOST=0.0.0.0
CHATGPT64_PORT=6464
OPENAI_MODEL=gpt-5.5
CHATGPT64_WIDTH=40
CHATGPT64_TERMINAL=ascii
CHATGPT64_MAX_INPUT=1200
CHATGPT64_ASCII_ONLY=1
CHATGPT64_ECHO=1
CHATGPT64_CHAR_DELAY_MS=0

# Optional tcpser helper settings for VICE/CCGMS
CHATGPT64_TCPSER_BIN=tcpser
CHATGPT64_TCPSER_LISTEN=25232
CHATGPT64_TCPSER_INCOMING_PORT=6400
CHATGPT64_TCPSER_BAUD=2400
CHATGPT64_TCPSER_LOG=4
CHATGPT64_TCPSER_INIT=s5=20
CHATGPT64_DIAL_NUMBER=6464
CHATGPT64_TCPSER_TARGET=127.0.0.1:6464

# Optional VICE helper settings
CHATGPT64_VICE_BIN=x64sc
CHATGPT64_VICE_HOST=127.0.0.1
CHATGPT64_VICE_LISTEN=25232
CHATGPT64_VICE_BAUD=2400
CHATGPT64_VICE_KEYMAP=
CHATGPT64_VICE_KEYMAP_MODE=2
